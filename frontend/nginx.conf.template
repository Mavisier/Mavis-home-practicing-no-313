server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;
    location /api/actions/ {
        proxy_pass http://backend:8000;
        proxy_set_header X-Demo-Token "${DEMO_REQUESTER_TOKEN}";
        proxy_set_header X-Demo-Approver-Token "${DEMO_APPROVER_TOKEN}";
        proxy_set_header Host $host;
    }
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header X-Demo-Token "${DEMO_REQUESTER_TOKEN}";
        proxy_set_header Host $host;
    }
    location /health {
        proxy_pass http://backend:8000;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
