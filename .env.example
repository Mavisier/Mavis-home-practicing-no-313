# Dummy localhost-only development settings. Fixture mode needs no API key.
# Compose overrides this URL with its native PostgreSQL service connection.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable
DATABASE_POOL_SIZE=1
DEMO_REQUESTER_TOKEN=local-demo-requester-change-me
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Used by Vite's server-side proxy, not embedded in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:8000
DEMO_APPROVER_TOKEN=local-demo-reviewer-change-me
# fixture is a deterministic keyless demo, not a live LLM.
LLM_PROVIDER=fixture
LLM_MODEL=
EMBEDDING_PROVIDER=fixture
EMBEDDING_MODEL=text-embedding-3-small
# Configure keys locally; do not commit .env or paste keys in chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional keyless local model: set LLM_PROVIDER=ollama and LLM_MODEL=qwen2.5:7b.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# For local neural embeddings: EMBEDDING_PROVIDER=ollama,
# EMBEDDING_MODEL=nomic-embed-text:v1.5, then re-ingest the sample documents.
